# Production settings for the API container. Copied to /opt/lawbuddy/lawbuddy.env by setup-ec2.sh; fill in the keys
# there (chmod 600). This file stays on the server: it is never committed or sent to GitHub.
# Keep comments on their own lines: some Docker tools read "KEY=value  # note" as part of the value.

# LLM (default backend) and Whisper transcription
GROQ_API_KEY=
# Embeddings and reranking (search); also an LLM backend
NVIDIA_API_KEY=
# Optional LLM backend
GEMINI_API_KEY=
LLM_BACKEND=groq

# The browser calls the API through Vercel's proxy (same origin), so CORS only matters for direct calls.
CORS_ORIGINS=https://YOUR-APP.vercel.app
# Per user: the real client IP arrives in X-Forwarded-For
RATE_LIMIT_PER_MIN=20
# Leave empty: a key baked into the public frontend bundle protects nothing
LAWBUDDY_API_KEY=
ALLOW_CUSTOM_LLM_BASE_URL=0
SESSION_TTL_MIN=120
# Fewer than locally: a t3.micro has 1 GB of RAM
MAX_SESSIONS=300
