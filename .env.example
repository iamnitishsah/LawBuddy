# LLM providers (free tiers). Only the key of the backend you use is required.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY         # also used for embeddings and reranking (configs/retrieval.yaml)

LLM_BACKEND=groq                           # groq | gemini | nvidia (configs/llm.yaml)

# API
LAWBUDDY_API_KEY=                          # empty: no key required
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MIN=20
